+import asyncio
+import json
+import logging
+import random
+from typing import Any
+
+from fastmcp import Client
+from fastmcp.client.transports import SSETransport
+
+from verl.tools.utils.mcp_clients.utils import TokenBucket, mcp2openai
+
+logger = logging.getLogger(__name__)
+
+
+class MCPClientManager:
+    rootServerName = "mcpServers"
+    initialized = False
+    clients = []
+    tool_client_mapping = {}
+    rate_limiter = None
+    mcp_call_max_retries = 3
+    mcp_call_initial_wait = 1.0
+    mcp_call_max_wait = 8.0
+
+    async def initialize(self, config_path, rate_limit: float = 10.0):
+        if self.initialized:
+            return
+        """Initialize the MCP Client Manager and start all clients"""
+        result = self._load_config(config_path)
+        servers = result[self.rootServerName]
+        exclude_sse_servers = {self.rootServerName: {}}
+        for server_name in servers.keys():
+            server = servers[server_name]
+            if "auth_token" in server:
+                transport = SSETransport(url=server["url"], headers={"Authorization": f"Bearer {server['auth_token']}"})
+                client = Client(transport)
+                self.clients.append(client)
+            else:
+                exclude_sse_servers[self.rootServerName][server_name] = server
+
+        if exclude_sse_servers[self.rootServerName]:
+            self.clients.append(Client(exclude_sse_servers))
+
+        # Initialize rate limiter
+        self.rate_limiter = TokenBucket(rate_limit)
+        self.initialized = True
+
+    async def call_tool(self, tool_name, parameters, timeout):
+        # Apply rate limiting
+        while not self.rate_limiter.acquire():
+            await asyncio.sleep(0.1)
+
+        client = self.get_client_with_tool_name(tool_name)
+        last_exception = None
+        request_timeout = timeout if isinstance(timeout, (int, float)) and timeout > 0 else None
+        for attempt in range(self.mcp_call_max_retries + 1):
+            try:
+                async with client:
+                    call_coro = client.call_tool_mcp(tool_name, parameters)
+                    if request_timeout is None:
+                        return await call_coro
+                    return await asyncio.wait_for(call_coro, timeout=request_timeout)
+            except Exception as exc:
+                last_exception = exc
+                if not self._is_retryable_mcp_exception(exc) or attempt >= self.mcp_call_max_retries:
+                    raise
+
+                wait_seconds = self._calculate_retry_wait(attempt + 1)
+                logger.warning(
+                    "MCP tool call failed with retryable error. "
+                    f"tool={tool_name}, attempt={attempt + 1}/{self.mcp_call_max_retries}, "
+                    f"wait={wait_seconds:.2f}s, error={exc}"
+                )
+                await asyncio.sleep(wait_seconds)
+
+        if last_exception:
+            raise last_exception
+
+    def _is_retryable_mcp_exception(self, exc: Exception) -> bool:
+        if isinstance(exc, asyncio.TimeoutError):
+            return True
+
+        exc_type = type(exc).__name__.lower()
+        error_text = str(exc).lower()
+        retryable_tokens = (
+            "timeout",
+            "connect",
+            "connection",
+            "temporarily unavailable",
+            "econnreset",
+            "broken pipe",
+            "network",
+            "remoteprotocolerror",
+            "readerror",
+            "writeerror",
+        )
+        return any(token in exc_type or token in error_text for token in retryable_tokens)
+
+    def _calculate_retry_wait(self, retry_count: int) -> float:
+        wait_time = self.mcp_call_initial_wait * (2 ** (retry_count - 1))
+        wait_time = min(wait_time, self.mcp_call_max_wait)
+        # 添加少量抖动，避免并发请求同步重试
+        return wait_time + random.uniform(0, 0.3 * wait_time)
+
+    async def fetch_tool_schemas(self, tool_selected_list: list[str]) -> list[dict]:
+        tool_schemas = []
+        for client in self.clients:
+            async with client:
+                tools = await client.list_tools_mcp()
+                for tool in tools.tools:
+                    if not tool_selected_list:
+                        self.tool_client_mapping[tool.name] = client
+                        tool_schemas.append(mcp2openai(tool))
+                    elif tool.name in tool_selected_list:
+                        self.tool_client_mapping[tool.name] = client
+                        tool_schemas.append(mcp2openai(tool))
+
+        return tool_schemas
+
+    def get_client_with_tool_name(self, tool_name: str):
+        return self.tool_client_mapping[tool_name]
+
+    def _load_config(self, file: str) -> dict[str, Any]:
+        try:
+            with open(file) as f:
+                return json.load(f)
+        except FileNotFoundError:
+            logger.warning(f'the "{file}" file was not found')
+        except Exception:
+            logger.error(f'there was an error reading the "{file}" file')
+
+        return {}
+
+
+ClientManager = MCPClientManager()
